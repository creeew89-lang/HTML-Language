<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Color Guesser</title>
<style>
body{
    font-family:Arial,sans-serif;
    text-align:center;
    padding:20px;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    height:100vh;
    margin:0;
    background:blanchedalmond;
    color:brown;
}
h1{margin-bottom:1rem;}
#colorBox{
    width:200px;
    height:200px;
    margin:0 auto 20px;
    border-radius:10px;
    box-shadow:0 4px 8px rgba(0,0,0,.2);
}
#choices{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
    justify-content:center;
}
button{
    padding:10px 20px;
    font-size:16px;
    border:none;
    border-radius:5px;
    cursor:pointer;
    background:brown;
    color:white;
    transition:background .3s, transform .1s;
}
button:hover{background:darkred;transform:scale(1.05);}
#msg{margin-top:20px;font-size:1.2rem;font-weight:bold;}
@media (prefers-color-scheme:dark){
    body{background:#2f3640;color:#f5f6fa;}
    button{background:#718093;}
    button:hover{background:#57606f;}
}
:hover{
    cursor:pointer;
    clip-rule: source-over;
    fill: red;
    stroke: black;
    stroke-width: 2px;
    stroke-linejoin: round;
    stroke-linecap: round;
    opacity: 0.8;
}
button:hover{
    background: darkred;
    transform: scale(1.05);
}
h1{
    margin-bottom: 1rem;
}
#colorBox{
    width: 200px;
    height: 200px;
    margin: 0 auto 20px;
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, .2);
}
#choices{
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
}
button{
    padding: 10px 20px;
    font-size: 16px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    background: brown;
    color: white;
    transition: background .3s, transform .1s;
}
button:hover {
    background: darkred;
    transform: scale(1.05);
}
#msg {
    margin-top: 20px;
    font-size: 1.2rem;
    font-weight: bold;
}
@media (prefers-color-scheme: dark) {
    body {
        background: #2f3640;
        color: #f5f6fa;
    }
    button {
        background: #718093;
    }
    button:hover {
        background: #57606f;
    }
}
label {
    margin-bottom: 8px;
    font-weight: bold;
    color: #333;
}
input, select, textarea {
    width: 100%;
    padding: 8px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 14px;
    box-sizing: border-box;
}
input:focus, select:focus, textarea:focus {
    border-color: #4CAF50;
    outline: none;
    box-shadow: 0 0 5px rgba(76, 175, 80, 0.5);
}
button {
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    font-size: 16px;
    cursor: pointer;
}
button {
    background-color: #4CAF50;
    color: white;
}
button:hover {
    background-color: #45a049;
}
button[type="reset"] {
    background-color: #f44336;
    color: white;
}   
button[type="reset"]:hover {
    background-color: #da190b;
}
</style>
</head>
<body>
<h1>Guess the Color!</h1>
<div id="colorBox"></div>
<div id="choices"></div>
<div id="msg"></div>
<script>
const colors=[{name:"Red",hex:"#ff4757"},{name:"Green",hex:"#2ed573"},{name:"Blue",hex:"#3742fa"},{name:"Yellow",hex:"#ffa502"},{name:"Purple",hex:"#a55eea"},{name:"Orange",hex:"#ff6348"}];
let correct=null;
function setupGame(){
    correct=Math.floor(Math.random()*colors.length);
    document.getElementById("colorBox").style.backgroundColor=colors[correct].hex;
    const choicesDiv=document.getElementById("choices");
    choicesDiv.innerHTML="";
    colors.forEach((color,index)=>{
        const btn=document.createElement("button");
        btn.innerText=color.name;
        btn.onclick=()=>checkAnswer(index);
        choicesDiv.appendChild(btn);
    });
    document.getElementById("msg").innerText="";
}
function checkAnswer(selected){
    const msgDiv=document.getElementById("msg");
    if(selected===correct){
        msgDiv.innerText="Correct! Well done.";
    }else{
        msgDiv.innerText=`Wrong! The correct color was ${colors[correct].name}.`;
    }
    setTimeout(setupGame,2000);
}
setupGame();
</script>
</body>
</html>
