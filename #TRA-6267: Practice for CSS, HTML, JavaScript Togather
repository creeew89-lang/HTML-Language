<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Day1 + Day2</title>
    <style>
        :root {
            --bg: #ffffff;
            --fg: #222222;
            --primary: #4caf50;
            --radius: 8px;
            --transition: .3s ease;
        }
        [data-theme="dark"] {
            --bg: #121212;
            --fg: #eeeeee;
            --primary: #66bb6a;
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }
        body {
            background: var(--bg);
            color: var(--fg);
            transition: background var(--transition), color var(--transition);
            padding: 20px;
        }
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding: 1rem 2rem;
            background: var(--primary);
            color: white;
        }
        #themeToggle {
            padding: .4rem .8rem;
            background: white;
            color: var(--primary);
            border: none;
            border-radius: var(--radius);
            cursor: pointer;
            font-weight: bold;
        }
        main {
            max-width: 800px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }
        section {
            scroll-margin-top: 2rem;
        }
        h2 {
            margin-bottom: 1rem;
            border-bottom: 2px solid var(--primary);
            padding-bottom: .5rem;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            box-shadow: 0 2px 8px rgba(0, 0, 0, .15);
        }
        thead {
            background: var(--primary);
            color: white;
        }
        th, td {
            padding: 12px 1rem;
            border: 1px solid var(--primary);
        }
        tbody tr:nth-child(even) {
            background: rgba(76, 175, 80, .1);
        }
        tbody tr:hover {
            background: rgba(76, 175, 80, .2);
            cursor: pointer;
        }
        form {
            max-width: 500px;
            margin: 30px auto;
            padding: 20px;
            border: 1px solid var(--primary);
            background: var(--bg);
            border-radius: var(--radius);
            box-shadow: 0 2px 8px rgba(0, 0, 0, .1);
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
        .form-group {
            display: flex;
            flex-direction: column;
        }
        label {
            margin-bottom: 8px;
            font-weight: bold;
            color: var(--fg);
        }
        input, select, textarea {
            width: 100%;
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 14px;
        }
        input:focus, select:focus, textarea:focus {
            border-color: var(--primary);
            outline: none;
            box-shadow: 0 0 5px rgba(76, 175, 80, .5);
        }
        .radio-group, .checkbox-group {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }
        .radio-group label, .checkbox-group label {
            display: flex;
            align-items: center;
            cursor: pointer;
            font-weight: normal;
            gap: .5rem;
        }
        input[type="radio"], input[type="checkbox"] {
            accent-color: var(--primary);
            width: 18px;
            height: 18px;
        }
        button {
            padding: .6rem 1.2rem;
            border: none;
            border-radius: var(--radius);
            background: var(--primary);
            color: #fff;
            font-size: 1rem;
            cursor: pointer;
            transition: opacity var(--transition);
        }
        button:hover {
            opacity: .9;
        }
        @media (max-width: 600px) {
            body {
                padding: 10px;
            }
            header {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }
            main {
                padding: 1rem;
            }
            th, td {
                padding: 8px;
            }
            .radio-group, .checkbox-group {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <header>
        <h1>Day 1 + Day 2 Practice</h1>
        <button id="themeToggle">🌓</button>
    </header>

    <main>
        <section id="student-grades">
            <h2>Student Grades</h2>
            <table id="grades-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Subject</th>
                        <th>Grade</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>AL-Muiayed</td>
                        <td>Math</td>
                        <td>85</td>
                    </tr>
                    <tr>
                        <td>Hura</td>
                        <td>Science</td>
                        <td>90</td>
                    </tr>
                    <tr>
                        <td>Barker</td>
                        <td>History</td>
                        <td>78</td>
                    </tr>
                </tbody>
            </table>
        </section>

        <section id="formSec">
            <h2>Student Registration</h2>
            <form>
                <div class="form-group">
                    <label for="name">Full Name</label>
                    <input type="text" id="name" name="name" required>
                    <placeholder="Enter your full name"></
                </div>
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required>
                    <placeholder="Enter your email address"></
                </div>
                <div class="form-group">
                    <label for="age">Age</label>
                    <input type="number" id="age" name="age" required>
                    <placeholder="Enter your age"></
                </div>
                <div class="form-group">
                    <label>Gender</label>
                    <div class="radio-group">
                        <label><input type="radio" name="gender" value="male" required> Male</label>
                        <label><input type="radio" name="gender" value="female" required> Female</label>
                        <placeholder><label><input type="radio" name="gender" value="other" required> Other</label>
                    </div>
                </div>
                <div class="form-group">
                    <label for="grade">Grade Level</label>
                    <select id="grade" name="grade" required>
                        <option value="" disabled selected>Select grade</option>
                        <option>9th Grade</option>
                        <option>10th Grade</option>
                        <option>11th Grade</option>
                        <option>12th Grade</option>
                        <placeholder required>  </placeholder>
                    </select>
                </div>
                <div class="form-group">
                    <label>Preferred Subjects</label>
                    <div class="checkbox-group">
                        <label><input type="checkbox" value="math"> Mathematics</label>
                        <label><input type="checkbox" value="sci"> Science</label>
                        <label><input type="checkbox" value="eng"> English</label>
                        <label><input type="checkbox" value="his"> History</label>
                         <placeholder required>  </placeholder>
                    </div>
                </div>
                <div class="form-group">
                    <label for="msg">Comments</label>
                    <textarea id="msg" name="msg" rows="3" placeholder="Anything else..."></textarea>
                </div>
                <button type="submit">Register</button>
                
            </form>
        </section>
    </main>

    <script>
        const toggle = document.getElementById('themeToggle');
        toggle.addEventListener('click', () => {
            const html = document.documentElement;
            html.setAttribute('data-theme',
                html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
        });
    </script>
</body>
</html>
